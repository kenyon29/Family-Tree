# Copy this file to .env for local development (vercel dev will read it).
# In production, set these as Environment Variables in your Vercel project settings.

# From your Airtable account (see SETUP.md for how to get these)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# The passcode family members type in to unlock Edit Mode. Pick anything you like.
EDITOR_PASSCODE=
